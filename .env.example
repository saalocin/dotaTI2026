# Copy to .env and fill in. .env is gitignored.

# Required by Liquipedia API terms: a way to contact you, embedded in the User-Agent.
CONTACT_EMAIL=you@example.com

# NOT needed for this pipeline (confirmed by OpenDota support: the free tier is
# keyless; a key only matters beyond free-tier limits — we run at ~55 req/min vs
# their 60/min cap and never exceed it). Leave empty unless throughput becomes tight.
OPENDOTA_API_KEY=

# Free token from https://stratz.com/api (Steam login). Optional gap-filler source.
STRATZ_TOKEN=
